<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Client Lead Temperature Assessment Matrix</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&family=Open+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --teal: #1B7F92;
            --mauve: #b36278;
            --light-teal: #2a9fb5;
            --light-mauve: #c47a95;
            --cream: #f8f6f3;
            --charcoal: #2a2a2a;
            --warm-white: #fefdfb;
            --shadow-teal: rgba(27, 127, 146, 0.15);
            --shadow-mauve: rgba(179, 98, 120, 0.15);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Open Sans', sans-serif;
            background: linear-gradient(135deg, var(--teal) 0%, var(--mauve) 100%);
            padding: 0;
            min-height: 100vh;
            overflow: hidden;
        }
        
        .container {
            display: flex;
            height: 100vh;
            max-width: none;
            margin: 0;
            background: transparent;
            border-radius: 0;
            padding: 0;
            box-shadow: none;
        }
        
        .header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
            background: var(--warm-white);
            padding: 20px;
            text-align: center;
            box-shadow: 0 2px 8px var(--shadow-teal);
            border-bottom: 3px solid var(--teal);
        }
        
        .header h1 {
            color: var(--teal);
            font-size: 1.8em;
            font-weight: 700;
            margin-bottom: 8px;
            font-family: 'Montserrat', sans-serif;
        }
        
        .header p {
            color: var(--charcoal);
            font-size: 1em;
            opacity: 0.8;
        }
        
        .assessment-grid {
            display: flex;
            width: 100%;
            height: 100vh;
            padding-top: 120px;
        }
        
        .criteria-section {
            width: 55%;
            background: var(--cream);
            padding: 30px;
            overflow-y: auto;
            height: calc(100vh - 120px);
        }
        
        .criteria-category {
            margin-bottom: 30px;
        }
        
        .category-title {
            font-size: 1.2em;
            font-weight: bold;
            color: var(--teal);
            margin-bottom: 15px;
            padding-bottom: 8px;
            border-bottom: 3px solid var(--mauve);
            font-family: 'Montserrat', sans-serif;
        }
        
        .criteria-item {
            margin-bottom: 20px;
            padding: 15px;
            background: var(--warm-white);
            border-radius: 8px;
            border-left: 4px solid var(--shadow-teal);
            transition: all 0.3s ease;
            box-shadow: 0 2px 8px var(--shadow-teal);
        }
        
        .criteria-item:hover {
            border-left-color: var(--teal);
            transform: translateX(5px);
            box-shadow: 0 4px 12px var(--shadow-teal);
        }
        
        .criteria-label {
            font-weight: 600;
            color: var(--charcoal);
            margin-bottom: 8px;
            font-size: 0.95em;
        }
        
        .criteria-options {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }
        
        .option-btn {
            padding: 6px 14px;
            border: 2px solid var(--shadow-teal);
            background: var(--warm-white);
            border-radius: 20px;
            font-size: 0.8em;
            cursor: pointer;
            transition: all 0.2s ease;
            color: var(--charcoal);
            font-weight: 500;
        }
        
        .option-btn:hover {
            background: var(--shadow-teal);
            transform: translateY(-1px);
        }
        
        .option-btn.selected {
            background: var(--teal);
            color: var(--warm-white);
            border-color: var(--teal);
            transform: translateY(-2px);
            box-shadow: 0 4px 8px var(--shadow-teal);
        }
        
        .results-section {
            width: 45%;
            background: linear-gradient(135deg, var(--teal) 0%, var(--mauve) 100%);
            color: var(--warm-white);
            padding: 30px;
            height: calc(100vh - 120px);
            overflow-y: auto;
            position: fixed;
            right: 0;
            top: 120px;
            transition: background 0.5s ease;
        }
        
        .temperature-display {
            text-align: center;
            margin-bottom: 20px;
        }
        
        .temperature-label {
            font-size: 2.2em;
            font-weight: bold;
            margin-bottom: 10px;
            font-family: 'Montserrat', sans-serif;
        }
        
        .temperature-score {
            font-size: 1.1em;
            opacity: 0.95;
        }
        
        .recommendation-box {
            background: rgba(254, 253, 251, 0.15);
            border: 2px solid rgba(254, 253, 251, 0.3);
            border-radius: 8px;
            padding: 18px;
            margin-bottom: 18px;
        }
        
        .recommendation-title {
            font-weight: bold;
            margin-bottom: 10px;
            font-size: 1.1em;
        }
        
        .next-actions {
            background: rgba(254, 253, 251, 0.15);
            border: 2px solid rgba(254, 253, 251, 0.3);
            border-radius: 8px;
            padding: 18px;
        }
        
        .next-actions h4 {
            margin-bottom: 12px;
            font-size: 1.1em;
        }
        
        .next-actions ul {
            list-style: none;
            padding-left: 0;
            margin: 0;
        }
        
        .next-actions li {
            padding: 6px 0;
            padding-left: 20px;
            position: relative;
            font-size: 0.9em;
            margin: 0;
            border: none;
            text-decoration: none;
        }
        
        .next-actions li:before {
            content: "→";
            position: absolute;
            left: 0;
            color: var(--warm-white);
            font-weight: bold;
            text-decoration: none;
        }
        
        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            margin-top: 25px;
        }
        
        .metric-card {
            background: rgba(254, 253, 251, 0.2);
            border: 2px solid rgba(254, 253, 251, 0.3);
            color: var(--warm-white);
            padding: 18px;
            border-radius: 8px;
            text-align: center;
        }
        
        .metric-number {
            font-size: 1.8em;
            font-weight: bold;
            display: block;
            font-family: 'Montserrat', sans-serif;
        }
        
        .metric-label {
            font-size: 0.85em;
            margin-top: 5px;
            opacity: 0.9;
        }
        
        .persona-match {
            margin-top: 20px;
            padding: 18px;
            background: rgba(254, 253, 251, 0.15);
            border: 2px solid rgba(254, 253, 251, 0.3);
            border-radius: 8px;
        }
        
        .persona-title {
            font-weight: bold;
            color: var(--warm-white);
            margin-bottom: 10px;
            font-size: 1.1em;
        }
        
        .reset-btn {
            background: var(--mauve);
            color: var(--warm-white);
            border: 2px solid var(--warm-white);
            padding: 12px 24px;
            border-radius: 6px;
            cursor: pointer;
            margin-top: 20px;
            margin-bottom: 20px;
            transition: all 0.3s ease;
            font-weight: 600;
            width: 100%;
        }
        
        .reset-btn:hover {
            background: var(--warm-white);
            color: var(--mauve);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px var(--shadow-mauve);
        }

        /* Custom scrollbar for criteria section */
        .criteria-section::-webkit-scrollbar {
            width: 8px;
        }
        
        .criteria-section::-webkit-scrollbar-track {
            background: var(--shadow-teal);
            border-radius: 4px;
        }
        
        .criteria-section::-webkit-scrollbar-thumb {
            background: var(--teal);
            border-radius: 4px;
        }
        
        .criteria-section::-webkit-scrollbar-thumb:hover {
            background: var(--mauve);
        }

        @media (max-width: 768px) {
            .assessment-grid {
                flex-direction: column;
                padding-top: 140px;
            }
            
            .criteria-section {
                width: 100%;
                height: 50vh;
                position: relative;
                padding-bottom: 60px; /* Add space for reset button */
            }
            
            .results-section {
                width: 100%;
                height: 50vh;
                position: relative;
                right: auto;
                top: auto;
                padding: 15px; /* Reduced from 30px */
                overflow-y: auto;
            }
            
            /* Compact mobile results styling */
            .temperature-display {
                margin-bottom: 12px; /* Reduced from 20px */
            }
            
            .temperature-label {
                font-size: 1.6em; /* Reduced from 2.2em */
                margin-bottom: 6px; /* Reduced from 10px */
            }
            
            .temperature-score {
                font-size: 0.9em; /* Reduced from 1.1em */
                margin-bottom: 8px;
            }
            
            .recommendation-box {
                padding: 12px; /* Reduced from 18px */
                margin-bottom: 12px; /* Reduced from 18px */
            }
            
            .recommendation-title {
                font-size: 0.95em; /* Slightly smaller */
                margin-bottom: 6px; /* Reduced from 10px */
            }
            
            .recommendation-box div:last-child {
                font-size: 0.85em; /* Smaller body text */
                line-height: 1.3;
            }
            
            .next-actions {
                padding: 12px; /* Reduced from 18px */
                margin-bottom: 12px;
            }
            
            .next-actions h4 {
                font-size: 0.95em; /* Smaller heading */
                margin-bottom: 8px; /* Reduced from 12px */
            }
            
            .next-actions li {
                font-size: 0.8em; /* Reduced from 0.9em */
                padding: 3px 0; /* Reduced from 6px */
                padding-left: 20px;
                line-height: 1.3;
                text-decoration: none;
                border: none;
                position: relative;
            }
            
            .next-actions li:before {
                content: "→";
                position: absolute;
                left: 0;
                color: var(--warm-white);
                font-weight: bold;
                text-decoration: none;
            }
            
            .persona-match {
                padding: 12px; /* Reduced from 18px */
                margin-top: 12px; /* Reduced from 20px */
            }
            
            .persona-title {
                font-size: 0.95em; /* Smaller */
                margin-bottom: 6px; /* Reduced from 10px */
            }
            
            .persona-match div:last-child {
                font-size: 0.85em;
                line-height: 1.3;
            }
            
            .metrics-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 8px; /* Reduced from 15px */
                margin-top: 12px; /* Reduced from 25px */
            }
            
            .metric-card {
                padding: 10px; /* Reduced from 18px */
            }
            
            .metric-number {
                font-size: 1.3em; /* Reduced from 1.8em */
            }
            
            .metric-label {
                font-size: 0.75em; /* Reduced from 0.85em */
                margin-top: 2px; /* Reduced from 5px */
            }
            
            .reset-btn {
                position: relative;
                bottom: auto;
                margin-top: 20px;
                margin-bottom: 20px;
                /* Remove sticky positioning on mobile */
            }
            
            .header h1 {
                font-size: 1.4em;
            }
            
            .header p {
                font-size: 0.9em;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Client Lead Temperature Assessment</h1>
            <p>Comprehensive qualification matrix to determine lead temperature and sales strategy</p>
        </div>
        
        <div class="assessment-grid">
            <div class="criteria-section">
                
                <div class="criteria-category">
                    <div class="category-title">Relationship & Connection</div>
                    
                    <div class="criteria-item">
                        <div class="criteria-label">How did they find you?</div>
                        <div class="criteria-options">
                            <button class="option-btn" data-category="source" data-value="5">Referral from client</button>
                            <button class="option-btn" data-category="source" data-value="4">Partner recommendation</button>
                            <button class="option-btn" data-category="source" data-value="3">Speaking/workshop</button>
                            <button class="option-btn" data-category="source" data-value="2">Content/LinkedIn</button>
                            <button class="option-btn" data-category="source" data-value="1">Cold search</button>
                        </div>
                    </div>
                    
                    <div class="criteria-item">
                        <div class="criteria-label">Existing relationship?</div>
                        <div class="criteria-options">
                            <button class="option-btn" data-category="relationship" data-value="5">Close connection</button>
                            <button class="option-btn" data-category="relationship" data-value="4">Previous interaction</button>
                            <button class="option-btn" data-category="relationship" data-value="3">Mutual connections</button>
                            <button class="option-btn" data-category="relationship" data-value="2">Aware of my work</button>
                            <button class="option-btn" data-category="relationship" data-value="1">No prior connection</button>
                        </div>
                    </div>
                    
                    <div class="criteria-item">
                        <div class="criteria-label">Decision-making authority?</div>
                        <div class="criteria-options">
                            <button class="option-btn" data-category="authority" data-value="5">Final decision maker</button>
                            <button class="option-btn" data-category="authority" data-value="4">Strong influence</button>
                            <button class="option-btn" data-category="authority" data-value="3">Part of committee</button>
                            <button class="option-btn" data-category="authority" data-value="2">Makes recommendation</button>
                            <button class="option-btn" data-category="authority" data-value="1">No authority</button>
                        </div>
                    </div>
                </div>
                
                <div class="criteria-category">
                    <div class="category-title">Need & Urgency</div>
                    
                    <div class="criteria-item">
                        <div class="criteria-label">Problem urgency?</div>
                        <div class="criteria-options">
                            <button class="option-btn" data-category="urgency" data-value="5">Crisis mode</button>
                            <button class="option-btn" data-category="urgency" data-value="4">Urgent timeline</button>
                            <button class="option-btn" data-category="urgency" data-value="3">Planned initiative</button>
                            <button class="option-btn" data-category="urgency" data-value="2">Future consideration</button>
                            <button class="option-btn" data-category="urgency" data-value="1">Just exploring</button>
                        </div>
                    </div>
                    
                    <div class="criteria-item">
                        <div class="criteria-label">Type of need?</div>
                        <div class="criteria-options">
                            <button class="option-btn" data-category="need_type" data-value="5">Strategic consulting</button>
                            <button class="option-btn" data-category="need_type" data-value="4">Problem solving</button>
                            <button class="option-btn" data-category="need_type" data-value="3">Process improvement</button>
                            <button class="option-btn" data-category="need_type" data-value="2">Training/development</button>
                            <button class="option-btn" data-category="need_type" data-value="1">Basic execution</button>
                        </div>
                    </div>
                    
                    <div class="criteria-item">
                        <div class="criteria-label">Pain vs Vision buyer?</div>
                        <div class="criteria-options">
                            <button class="option-btn" data-category="motivation" data-value="5">Vision-driven growth</button>
                            <button class="option-btn" data-category="motivation" data-value="4">Strategic opportunity</button>
                            <button class="option-btn" data-category="motivation" data-value="3">Mixed pain/vision</button>
                            <button class="option-btn" data-category="motivation" data-value="2">Problem-reactive</button>
                            <button class="option-btn" data-category="motivation" data-value="1">Crisis-reactive</button>
                        </div>
                    </div>
                </div>
                
                <div class="criteria-category">
                    <div class="category-title">Budget & Investment Mindset</div>
                    
                    <div class="criteria-item">
                        <div class="criteria-label">Budget discussions?</div>
                        <div class="criteria-options">
                            <button class="option-btn" data-category="budget" data-value="5">Clear budget allocated</button>
                            <button class="option-btn" data-category="budget" data-value="4">Investment mindset</button>
                            <button class="option-btn" data-category="budget" data-value="3">Needs approval</button>
                            <button class="option-btn" data-category="budget" data-value="2">Price conscious</button>
                            <button class="option-btn" data-category="budget" data-value="1">Cost-focused</button>
                        </div>
                    </div>
                    
                    <div class="criteria-item">
                        <div class="criteria-label">Previous consultant experience?</div>
                        <div class="criteria-options">
                            <button class="option-btn" data-category="experience" data-value="5">Values strategic expertise</button>
                            <button class="option-btn" data-category="experience" data-value="4">Positive past experience</button>
                            <button class="option-btn" data-category="experience" data-value="3">Mixed experiences</button>
                            <button class="option-btn" data-category="experience" data-value="2">Skeptical but open</button>
                            <button class="option-btn" data-category="experience" data-value="1">Been burned before</button>
                        </div>
                    </div>
                </div>
                
                <div class="criteria-category">
                    <div class="category-title">Engagement Quality</div>
                    
                    <div class="criteria-item">
                        <div class="criteria-label">Communication style?</div>
                        <div class="criteria-options">
                            <button class="option-btn" data-category="communication" data-value="5">Strategic dialogue</button>
                            <button class="option-btn" data-category="communication" data-value="4">Thoughtful questions</button>
                            <button class="option-btn" data-category="communication" data-value="3">Good back-and-forth</button>
                            <button class="option-btn" data-category="communication" data-value="2">Basic responses</button>
                            <button class="option-btn" data-category="communication" data-value="1">One-way requests</button>
                        </div>
                    </div>
                    
                    <div class="criteria-item">
                        <div class="criteria-label">Timeline expectations?</div>
                        <div class="criteria-options">
                            <button class="option-btn" data-category="timeline" data-value="5">Ready to start soon</button>
                            <button class="option-btn" data-category="timeline" data-value="4">Next 30-60 days</button>
                            <button class="option-btn" data-category="timeline" data-value="3">Next quarter</button>
                            <button class="option-btn" data-category="timeline" data-value="2">Sometime this year</button>
                            <button class="option-btn" data-category="timeline" data-value="1">Just exploring</button>
                        </div>
                    </div>
                </div>
                
                <button class="reset-btn" onclick="resetAssessment()">Reset Assessment</button>
            </div>
            
            <div class="results-section">
                <div class="temperature-display">
                    <div class="temperature-label" id="temperatureLabel">UNASSESSED</div>
                    <div class="temperature-score" id="temperatureScore">Complete assessment to see lead temperature</div>
                </div>
                
                <div class="recommendation-box" id="recommendationBox">
                    <div class="recommendation-title">Assessment in Progress</div>
                    <div id="recommendationText">Select options from the left to generate your lead temperature and strategy recommendations.</div>
                </div>
                
                <div class="next-actions" id="nextActions">
                    <h4>Next Actions:</h4>
                    <ul id="actionsList">
                        <li>Complete the assessment criteria</li>
                        <li>Review lead temperature rating</li>
                        <li>Follow suggested engagement strategy</li>
                    </ul>
                </div>
                
                <div class="persona-match" id="personaMatch" style="display: none;">
                    <div class="persona-title">Likely Persona Match:</div>
                    <div id="personaText"></div>
                </div>
                
                <div class="metrics-grid">
                    <div class="metric-card">
                        <span class="metric-number" id="totalScore">0</span>
                        <div class="metric-label">Total Score</div>
                    </div>
                    <div class="metric-card">
                        <span class="metric-number" id="completeness">0%</span>
                        <div class="metric-label">Complete</div>
                    </div>
                    <div class="metric-card">
                        <span class="metric-number" id="maxPossible">50</span>
                        <div class="metric-label">Max Score</div>
                    </div>
                    <div class="metric-card">
                        <span class="metric-number" id="salesCycle">TBD</span>
                        <div class="metric-label">Sales Cycle</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        let assessmentData = {};
        const totalCriteria = 10;
        
        function updateAssessment(category, value) {
            assessmentData[category] = parseInt(value);
            updateResults();
        }
        
        const recommendations = {
            hot: {
                label: "HOT 🔥",
                color: "#fefdfb",
                bgColor: "linear-gradient(135deg, #d32f2f, #b71c1c)",
                text: "Ready buyer with existing relationship. Focus on removing friction from the buying journey.",
                actions: [
                    "Send proposal within 24-48 hours",
                    "Offer multiple engagement options",
                    "Schedule immediate kickoff conversation",
                    "Provide case studies and testimonials",
                    "Ask about timeline and start date preferences"
                ],
                cycle: "< 30 days",
                persona: "Vision-driven leader ready for strategic transformation"
            },
            warm: {
                label: "WARM 🌡️",
                color: "#fefdfb",
                bgColor: "linear-gradient(135deg, #f57c00, #e65100)",
                text: "Known need but not yet active. Focus on advancing the relationship and understanding decision process.",
                actions: [
                    "Schedule discovery conversation",
                    "Share relevant case studies",
                    "Understand decision-making process",
                    "Identify all stakeholders",
                    "Provide value-based educational content"
                ],
                cycle: "30-90 days",
                persona: "Established professional with clear challenges and authority"
            },
            lukewarm: {
                label: "LUKEWARM ⚡",
                color: "#2a2a2a",
                bgColor: "linear-gradient(135deg, #fbc02d, #f57f17)",
                text: "Predictable need but underdeveloped relationship. Focus on rapport building and clarification.",
                actions: [
                    "Invest in relationship building",
                    "Clarify authority, budget, and timeline",
                    "Understand buyer journey and process",
                    "Provide educational resources",
                    "Ask for introductions to other stakeholders"
                ],
                cycle: "60-120 days",
                persona: "Professional with potential need but requires more relationship development"
            },
            cool: {
                label: "COOL ❄️",
                color: "#fefdfb",
                bgColor: "linear-gradient(135deg, #1B7F92, #155a66)",
                text: "Possible need with limited relationship. Focus on finding connection through referrals or networking.",
                actions: [
                    "Seek warm introductions",
                    "Provide valuable content with no ask",
                    "Attend events where they'll be present",
                    "Connect on LinkedIn and engage with content",
                    "Find mutual connections for introduction"
                ],
                cycle: "> 90 days",
                persona: "Professional who fits ideal client persona but needs significant relationship development"
            },
            cold: {
                label: "COLD 🧊",
                color: "#fefdfb",
                bgColor: "linear-gradient(135deg, #1565c0, #0d47a1)",
                text: "Unknown need, not yet in funnel. Focus on research and finding connections.",
                actions: [
                    "Research company and decision makers",
                    "Find connector for warm introduction",
                    "Create valuable content they'd find useful",
                    "Engage with their content on LinkedIn",
                    "Consider if they're worth the investment"
                ],
                cycle: "> 120 days",
                persona: "May fit ideal client profile but requires significant research and relationship building"
            }
        };
        
        function calculateTemperature(data) {
            // Auto-qualification rules - these combinations immediately set temperature
            const autoQualifiers = {
                hot: [
                    // Decision maker + high urgency + referral = instant hot
                    () => data.authority >= 4 && data.urgency >= 4 && data.source >= 4,
                    // Crisis mode + budget allocated + existing relationship = instant hot  
                    () => data.urgency === 5 && data.budget >= 4 && data.relationship >= 3,
                    // Strategic need + investment mindset + ready timeline = instant hot
                    () => data.need_type >= 4 && data.budget >= 4 && data.timeline >= 4
                ],
                warm: [
                    // Decision authority + clear need + some relationship = warm
                    () => data.authority >= 4 && data.need_type >= 3 && data.relationship >= 3,
                    // Good relationship + planned initiative + strategic dialogue = warm
                    () => data.relationship >= 4 && data.urgency >= 3 && data.communication >= 4
                ],
                cold: [
                    // No authority + no relationship + just exploring = cold
                    () => data.authority <= 2 && data.relationship <= 2 && data.urgency <= 2,
                    // Been burned + cost-focused + no timeline = cold
                    () => data.experience <= 2 && data.budget <= 2 && data.timeline <= 2
                ]
            };
            
            // Check auto-qualifiers first
            for (const condition of autoQualifiers.hot) {
                if (condition()) return 'hot';
            }
            for (const condition of autoQualifiers.cold) {
                if (condition()) return 'cold';
            }
            for (const condition of autoQualifiers.warm) {
                if (condition()) return 'warm';
            }
            
            // If no auto-qualifiers, use weighted scoring
            const weights = {
                // Relationship factors (40% of total weight)
                source: 3,      // How they found you is crucial
                relationship: 4, // Existing relationship is huge
                authority: 5,   // Decision authority is critical
                
                // Need factors (35% of total weight) 
                urgency: 4,     // Urgency drives sales cycles
                need_type: 3,   // Strategic vs tactical matters
                motivation: 2,  // Pain vs vision buying
                
                // Qualification factors (25% of total weight)
                budget: 3,      // Budget discussions are key
                experience: 2,  // Past experience shapes approach
                communication: 2, // Engagement quality
                timeline: 2     // Timeline expectations
            };
            
            let weightedScore = 0;
            let maxWeightedScore = 0;
            
            Object.keys(weights).forEach(key => {
                if (data[key]) {
                    weightedScore += data[key] * weights[key];
                }
                maxWeightedScore += 5 * weights[key];
            });
            
            const percentage = (weightedScore / maxWeightedScore) * 100;
            
            // Realistic thresholds based on weighted scoring
            if (percentage >= 75) return 'hot';
            if (percentage >= 60) return 'warm'; 
            if (percentage >= 40) return 'lukewarm';
            if (percentage >= 25) return 'cool';
            return 'cold';
        }
        
        function updateResults() {
            const completedCriteria = Object.keys(assessmentData).length;
            const completeness = Math.round((completedCriteria / totalCriteria) * 100);
            
            // Update metrics
            document.getElementById('completeness').textContent = completeness + '%';
            
            // Only show temperature if 100% complete
            if (completeness < 100) {
                document.getElementById('temperatureLabel').textContent = 'IN PROGRESS';
                document.getElementById('temperatureLabel').style.color = '#fefdfb';
                document.getElementById('temperatureScore').textContent = `${completedCriteria}/${totalCriteria} criteria completed`;
                document.getElementById('recommendationText').textContent = 'Complete all assessment criteria to see lead temperature and recommendations.';
                document.getElementById('salesCycle').textContent = 'TBD';
                document.getElementById('personaMatch').style.display = 'none';
                
                // Reset to default background
                const resultsSection = document.querySelector('.results-section');
                resultsSection.style.background = 'linear-gradient(135deg, #1B7F92 0%, #b36278 100%)';
                
                // Show basic actions
                const actionsList = document.getElementById('actionsList');
                actionsList.innerHTML = `
                    <li>Complete remaining ${totalCriteria - completedCriteria} criteria</li>
                    <li>All questions must be answered for accurate assessment</li>
                    <li>Temperature will be calculated automatically</li>
                `;
                
                document.getElementById('totalScore').textContent = 'N/A';
                return;
            }
            
            // Calculate temperature using realistic logic
            const temperature = calculateTemperature(assessmentData);
            const rec = recommendations[temperature];
            
            // Calculate display score for reference
            const totalScore = Object.values(assessmentData).reduce((sum, val) => sum + val, 0);
            
            // Update display
            const tempLabel = document.getElementById('temperatureLabel');
            const tempScore = document.getElementById('temperatureScore');
            const resultsSection = document.querySelector('.results-section');
            
            tempLabel.textContent = rec.label;
            tempLabel.style.color = rec.color;
            tempScore.textContent = `Completed Assessment (${totalScore}/50 raw score)`;
            
            // Update background color of results section
            resultsSection.style.background = rec.bgColor;
            
            // Update recommendation
            document.getElementById('recommendationText').textContent = rec.text;
            document.getElementById('salesCycle').textContent = rec.cycle;
            document.getElementById('totalScore').textContent = totalScore;
            
            // Update actions
            const actionsList = document.getElementById('actionsList');
            actionsList.innerHTML = '';
            rec.actions.forEach(action => {
                const li = document.createElement('li');
                li.textContent = action;
                actionsList.appendChild(li);
            });
            
            // Update persona match
            const personaMatch = document.getElementById('personaMatch');
            const personaText = document.getElementById('personaText');
            personaMatch.style.display = 'block';
            personaText.textContent = rec.persona;
        }
        
        function resetAssessment() {
            assessmentData = {};
            document.querySelectorAll('.option-btn.selected').forEach(btn => {
                btn.classList.remove('selected');
            });
            
            const tempLabel = document.getElementById('temperatureLabel');
            const resultsSection = document.querySelector('.results-section');
            
            tempLabel.textContent = 'UNASSESSED';
            tempLabel.style.color = '#fefdfb';
            document.getElementById('temperatureScore').textContent = 'Complete assessment to see lead temperature';
            document.getElementById('recommendationText').textContent = 'Select options from the left to generate your lead temperature and strategy recommendations.';
            document.getElementById('totalScore').textContent = '0';
            document.getElementById('completeness').textContent = '0%';
            document.getElementById('salesCycle').textContent = 'TBD';
            document.getElementById('personaMatch').style.display = 'none';
            
            // Reset background to default
            resultsSection.style.background = 'linear-gradient(135deg, #1B7F92 0%, #b36278 100%)';
            
            const actionsList = document.getElementById('actionsList');
            actionsList.innerHTML = `
                <li>Complete the assessment criteria</li>
                <li>Review lead temperature rating</li>
                <li>Follow suggested engagement strategy</li>
            `;
        }
        
        // Add click handlers to option buttons
        document.querySelectorAll('.option-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const category = this.dataset.category;
                const value = this.dataset.value;
                
                // Remove selected class from siblings
                this.parentElement.querySelectorAll('.option-btn').forEach(sibling => {
                    sibling.classList.remove('selected');
                });
                
                // Add selected class to clicked button
                this.classList.add('selected');
                
                // Update assessment
                updateAssessment(category, value);
            });
        });
        
        // Initialize
        updateResults();
    </script>
</body>
</html>
